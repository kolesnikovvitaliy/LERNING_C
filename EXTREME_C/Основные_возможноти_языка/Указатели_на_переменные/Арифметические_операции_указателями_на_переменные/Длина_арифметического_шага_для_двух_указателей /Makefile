# ==============================================================================
# 🛠️ MAKEFILE ДЛЯ УЧЕБНОГО ПРОЕКТА ПО УКАЗАТЕЛЯМ В ЯЗЫКЕ C
# ==============================================================================

# 1. Переменные компилятора и флагов
CC       = gcc
CFLAGS   = -g -o0
IGNORE   = -Wno-pointer-to-int-cast # Тот самый флаг для игнорирования вашего варнинга
TARGET   = main

# 2. Список исходных файлов
SRC      = len_step_ptr.c
OBJ      = $(SRC:.c=.o)

# 3. Главная цель (вызывается просто по команде 'make')
all: $(TARGET) clean
	@echo "🟢 [SUCCESS] Программа успешно собрана! Запуск: ./$(TARGET)"

# 4. Сборка исполняемого файла
$(TARGET): $(OBJ)
	@$(CC) $(CFLAGS) $(IGNORE) $(OBJ) -o $(TARGET)

# 5. Компиляция объектных файлов
%.o: %.c
	@$(CC) $(CFLAGS) $(IGNORE) -c $< -o $@

# 6. Очистка проекта (команда 'make clean')
clean:
	@rm -f $(OBJ)
	@echo "🧹 [CLEAN] Все объектные и исполняемые файлы удалены!"

# 7. Запуск под отладчиком Valgrind (команда 'make check')
check: $(TARGET)
	@echo "🔍 [VALGRIND] Запуск проверки памяти..."
	@valgrind --leak-check=full --track-origins=yes ./$(TARGET)

# Указываем, что эти цели не являются реальными файлами
.PHONY: all clean check
